{
  "name": "miniature-worlds",
  "private": true,
  "version": "0.1.0",
  "description": "Miniature world tiles built in code with threepipe and the webgi plugins: a world kit, one finished tile and instructions for coding agents.",
  "keywords": [
    "threepipe",
    "webgi",
    "three.js",
    "webgl",
    "procedural generation",
    "procedural terrain",
    "miniature world",
    "diorama",
    "global illumination",
    "ssgi",
    "real-time rendering",
    "coding agent"
  ],
  "homepage": "https://files.threepipe.org/p/miniature-worlds/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/repalash/miniature-worlds.git"
  },
  "bugs": {
    "url": "https://github.com/repalash/miniature-worlds/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc",
    "preview": "vite preview",
    "shot": "node scripts/shot.mjs",
    "shot:install": "playwright install chromium"
  },
  "dependencies": {
    "@threepipe/plugin-tweakpane": "^0.10.2",
    "@threepipe/webgi-plugins": "^0.7.0",
    "threepipe": "^0.6.1"
  },
  "devDependencies": {
    "playwright": "^1.65.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.8"
  }
}
